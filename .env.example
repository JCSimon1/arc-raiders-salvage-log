POSTGRES_PASSWORD=changeme
WEB_PORT=<(Optional) Override the default port (8080) where the app should be reachable on your host>
IMAGE_MOUNT=<(Optional) Override the default mount point (/images) for you images. This folder should contain 2 subfolders /conditions und /maps.
STEAM_API_KEY=<(Optional) Your Steam Web API key from https://steamcommunity.com/dev/apikey. Together with STEAM_ID it enables the Steam profile card.>
STEAM_ID=<(Optional) Your 64-bit SteamID (steamID64). Required together with STEAM_API_KEY. Retrieve it from https://steamid.io>